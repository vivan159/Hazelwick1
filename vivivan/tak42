import random

score = 0
round_count = 0  


while True:
    secret = random.randint(0, 100)
    guess = int(input("Guess the number (0-100): "))
    
   
    diff = abs(guess - secret)
        
    if diff == 0:
        print("Bang-on!")
        score = score + 10
    elif diff <= 5:
        print("Close!")
        score = score + 5
    elif diff <= 10:
        print("Okay.")
        score = score + 2
    else:
        print("Way off!")
        score = score + 0

    
    round_count = round_count + 1
    
    
    if round_count == 5:
        break

print("Final score:")
print(score)